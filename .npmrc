# pnpm configuration
# Enforce the Node.js engine range declared in package.json
engine-strict=true

# Resolve peer dependencies automatically (required by Angular's package set)
auto-install-peers=true

# Security: do not run lifecycle install scripts automatically.
# Scripts for trusted packages must be allow-listed via
# pnpm.onlyBuiltDependencies in package.json (pnpm will prompt/report them).
