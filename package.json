{
  "name": "angular-dev",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "serve": "pnpm exec ng serve",
    "build": "ng build",
    "build:prod": "pnpm exec ng build --configuration production",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "test:ci": "pnpm exec ng test --watch=false",
    "install:ci": "pnpm install --frozen-lockfile",
    "reinstall": "pnpm install --force",
    "format": "pnpm exec prettier --write \"src/**/*.{ts,html,css,json}\"",
    "format:check": "pnpm exec prettier --check \"src/**/*.{ts,html,css,json}\""
  },
  "private": true,
  "packageManager": "pnpm@12.18.0",
  "dependencies": {
    "@angular/common": "^22.2.0",
    "@angular/compiler": "^22.2.0",
    "@angular/core": "^22.2.0",
    "@angular/forms": "^22.2.0",
    "@angular/platform-browser": "^22.2.0",
    "@angular/router": "^22.2.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.2.6",
    "@angular/cli": "^22.2.6",
    "@angular/compiler-cli": "^22.2.0",
    "@tailwindcss/postcss": "^4.1.12",
    "jsdom": "^30.0.0",
    "postcss": "^8.5.3",
    "prettier": "^3.8.1",
    "tailwindcss": "^4.1.12",
    "typescript": "~6.0.2",
    "vitest": "^5.0.0"
  }
}
